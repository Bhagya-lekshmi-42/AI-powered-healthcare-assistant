# Copy this file to .env and fill in your own values. Never commit .env.

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=healthcare_db

# App security
# Long random string used to sign sessions, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string
# Password required to open the Patient History Dashboard
HISTORY_PASSWORD=choose_a_strong_dashboard_password

# Set to 1 only while developing locally
FLASK_DEBUG=0
